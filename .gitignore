# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/

# Native/CircuitPython build trees and third-party checkout.
**/build/
**/build-*/
/circuitpython_single_uf2/circuitpython-src/
/circuitpython_single_uf2/__pycache__/

# Generated filesystem images may embed private Wi-Fi settings.
/circuitpython_single_uf2/*.img

# Local/private snapshots and old binaries are deliberately not published.
/outputs/
/work/

# Public, credential-free release artifacts and audit documentation.
!/release-assets/
!/docs/

# Never commit live CircuitPython credentials.
settings.toml
settings.toml.private
**/settings.toml.private
